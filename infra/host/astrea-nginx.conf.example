# Astrea host-level TLS reverse proxy template.
# Replace both placeholders before installing this file:
#   __ASTREA_DOMAIN__       -> production hostname only, for example astrea.example.org
#   __ASTREA_WEB_UPSTREAM__ -> container web endpoint reachable from the host,
#                             normally 172.30.250.10:80 with the production env template
#
# The container Nginx trusts X-Real-IP only from ASTREA_HOST_PROXY_IP. On the
# default edge subnet the Linux host is expected to appear as 172.30.250.1.
# Re-verify that address on the real VPS before public cutover.

server {
    listen 80;
    listen [::]:80;
    server_name __ASTREA_DOMAIN__;
    server_tokens off;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __ASTREA_DOMAIN__;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/__ASTREA_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ASTREA_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ASTREA_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # The inner Nginx keeps the stricter 1 MiB generic limit and the exact
    # 12 MiB candidate-path exception. The outer proxy must not reject that
    # accepted candidate envelope first.
    client_max_body_size 12m;

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    send_timeout 30s;

    location / {
        proxy_pass http://__ASTREA_WEB_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_redirect off;
    }
}
