# Astrea production Compose environment template.
# Copy to a root-owned file outside the repository, for example:
#   /etc/astrea/astrea.env
# Never commit the real file.

ASTREA_HTTP_PORT=8080
ASTREA_EDGE_SUBNET=172.30.250.0/24
ASTREA_HOST_PROXY_IP=172.30.250.1
ASTREA_PROXY_IP=172.30.250.10
ASTREA_BACKUP_ROOT=/var/backups/astrea
ASTREA_BACKUP_RETENTION_COUNT=14

POSTGRES_DB=astrea
POSTGRES_USER=astrea
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

APP_ENV=production
ADMIN_INITIAL_USERNAME=replace-with-admin-username
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT_REQUESTS=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# The public origin is compiled into the frontend image. Use one bare HTTPS origin,
# with no path, query or trailing slash.
VITE_PUBLIC_SITE_ORIGIN=https://replace-me.invalid

# Candidate intake remains fail-closed for the public informational launch.
VITE_CANDIDATE_FORM_ENABLED=false
CANDIDATE_INTAKE_ENABLED=false
CANDIDATE_PERSONAL_DATA_CONSENT_VERSION=
CANDIDATE_PRIVACY_POLICY_VERSION=
CANDIDATE_SAINT_PETERSBURG_ACKNOWLEDGEMENT_VERSION=
CANDIDATE_RATE_LIMIT_REQUESTS=5
CANDIDATE_RATE_LIMIT_WINDOW_SECONDS=900

# Mail remains inactive until the separately approved SMTP/legal activation stage.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
APPLICATION_NOTIFICATION_EMAIL=info@mason-astrea.ru
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
SITE_BASE_URL=https://replace-me.invalid
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_OUTBOX_RETRY_MAX_SECONDS=3600
EMAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=900
